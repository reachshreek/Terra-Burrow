<mujoco model="halo_bunny">
  <!-- Generated by build_model.py from the BOM and part_masses.csv. Do not edit by hand. -->
  <compiler angle="radian" autolimits="true"/>
  <!-- cone="elliptic": MuJoCo's default pyramidal friction grips differently along the
       floor's x/y axes than along diagonals, which made turning depend on world heading. -->
  <option timestep="0.0005" integrator="implicitfast" cone="elliptic"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.25 0.27 0.3" rgb2="0.3 0.32 0.35" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="20 20"/>
  </asset>

  <default>
    <!-- Robot geoms collide with the floor but not with each other.
         Their friction is low so the floor's friction value always wins. -->
    <geom contype="2" conaffinity="1" condim="3" friction="0.1 0.005 0.0001"
          solref="0.004 1" solimp="0.9 0.95 0.001"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="10 10 0.1" contype="1" conaffinity="1"
          friction="0.9 0.005 0.0001" material="grid"/>

    <body name="torso" pos="0 0 0.0995984">
      <freejoint name="root"/>
      <inertial pos="-0.00202562 0 -0.00439151" mass="1.249" fullinertia="0.0021708 0.00752565 0.00791825 0 -0.000590939 0"/>
      <geom name="torso_shell" type="ellipsoid" size="0.14 0.065 0.055" rgba="0.95 0.93 0.9 1"/>
      <geom name="head" type="sphere" pos="0.12 0 0.05" size="0.045" rgba="0.95 0.93 0.9 1"/>
      <geom name="ear_left" type="capsule" fromto="0.11 0.02 0.08 0.08 0.035 0.17" size="0.012"
            contype="0" conaffinity="0" rgba="0.95 0.8 0.8 1"/>
      <geom name="ear_right" type="capsule" fromto="0.11 -0.02 0.08 0.08 -0.035 0.17" size="0.012"
            contype="0" conaffinity="0" rgba="0.95 0.8 0.8 1"/>
      <site name="imu" pos="0 0 0.02" size="0.005"/>
      
      <body name="rear_thigh_left" pos="-0.05 0.06 -0.03" euler="0 0.349066 0">
        <joint name="hip_left" type="hinge" axis="0 1 0" range="0.0872665 1.39626"
               armature="0.002" damping="0.01"/>
        <inertial pos="0 0 -0.0326017" mass="0.118" fullinertia="7.78548e-05 7.82923e-05 1.5625e-06 0 0 0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.07" size="0.008" rgba="0.85 0.85 0.85 1"/>
        <body name="rear_shin_left" pos="0 0 -0.07">
          <joint name="knee_left" type="hinge" axis="0 1 0" range="-3.1 0.3" damping="0.01"/>
          <inertial pos="0 0 -0.0444643" mass="0.028" fullinertia="1.47236e-05 1.48586e-05 6.15e-07 0 0 0"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.07" size="0.007" rgba="0.85 0.85 0.85 1"/>
          <geom name="rear_foot_left" type="sphere" pos="0 0 -0.07" size="0.012" rgba="0.2 0.2 0.2 1"/>
        </body>
      </body>
      
      <body name="rear_thigh_right" pos="-0.05 -0.06 -0.03" euler="0 0.349066 0">
        <joint name="hip_right" type="hinge" axis="0 1 0" range="0.0872665 1.39626"
               armature="0.002" damping="0.01"/>
        <inertial pos="0 0 -0.0326017" mass="0.118" fullinertia="7.78548e-05 7.82923e-05 1.5625e-06 0 0 0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.07" size="0.008" rgba="0.85 0.85 0.85 1"/>
        <body name="rear_shin_right" pos="0 0 -0.07">
          <joint name="knee_right" type="hinge" axis="0 1 0" range="-3.1 0.3" damping="0.01"/>
          <inertial pos="0 0 -0.0444643" mass="0.028" fullinertia="1.47236e-05 1.48586e-05 6.15e-07 0 0 0"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.07" size="0.007" rgba="0.85 0.85 0.85 1"/>
          <geom name="rear_foot_right" type="sphere" pos="0 0 -0.07" size="0.012" rgba="0.2 0.2 0.2 1"/>
        </body>
      </body>
      
      <body name="front_leg_left" pos="0.1 0.05 -0.03">
        <joint name="front_spring_left" type="slide" axis="0 0 1" range="0 0.03"
               stiffness="1500.0" springref="0" damping="30.0"/>
        <inertial pos="0 0 -0.0243939" mass="0.033" fullinertia="8.32955e-06 8.32955e-06 7.5e-07 0 0 0"/>
        <body name="front_thigh_left">
          <joint name="front_hip_left" type="hinge" axis="0 1 0" range="0.0872665 1.48353"
                 armature="0.002" damping="0.01"/>
          <inertial pos="0 0 -0.019" mass="0.05" fullinertia="7.43e-06 7.7e-06 1.23e-06 0 0 0"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.045" size="0.007" rgba="0.85 0.85 0.85 1"/>
          <body name="front_shin_left" pos="0 0 -0.045">
            <joint name="front_knee_left" type="hinge" axis="0 1 0" range="-3.1 0.3" damping="0.01"/>
            <inertial pos="0 0 -0.025" mass="0.015" fullinertia="2.65625e-06 2.71125e-06 3.05e-07 0 0 0"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.045" size="0.006" rgba="0.85 0.85 0.85 1"/>
            <geom name="front_foot_left" type="sphere" pos="0 0 -0.045" size="0.012" rgba="0.2 0.2 0.2 1"/>
          </body>
        </body>
      </body>
      
      <body name="front_leg_right" pos="0.1 -0.05 -0.03">
        <joint name="front_spring_right" type="slide" axis="0 0 1" range="0 0.03"
               stiffness="1500.0" springref="0" damping="30.0"/>
        <inertial pos="0 0 -0.0243939" mass="0.033" fullinertia="8.32955e-06 8.32955e-06 7.5e-07 0 0 0"/>
        <body name="front_thigh_right">
          <joint name="front_hip_right" type="hinge" axis="0 1 0" range="0.0872665 1.48353"
                 armature="0.002" damping="0.01"/>
          <inertial pos="0 0 -0.019" mass="0.05" fullinertia="7.43e-06 7.7e-06 1.23e-06 0 0 0"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.045" size="0.007" rgba="0.85 0.85 0.85 1"/>
          <body name="front_shin_right" pos="0 0 -0.045">
            <joint name="front_knee_right" type="hinge" axis="0 1 0" range="-3.1 0.3" damping="0.01"/>
            <inertial pos="0 0 -0.025" mass="0.015" fullinertia="2.65625e-06 2.71125e-06 3.05e-07 0 0 0"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.045" size="0.006" rgba="0.85 0.85 0.85 1"/>
            <geom name="front_foot_right" type="sphere" pos="0 0 -0.045" size="0.012" rgba="0.2 0.2 0.2 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <!-- The hind-leg linkage: knee angle = -2 x hip angle keeps each foot on its push axis. -->
    <joint joint1="knee_left" joint2="hip_left" polycoef="0 -2 0 0 0" solref="0.002 1"/>
    <joint joint1="knee_right" joint2="hip_right" polycoef="0 -2 0 0 0" solref="0.002 1"/>
    <!-- Ratchet pawls: lock each hip where it caught. legs.py switches them on and off. -->
    <joint name="latch_left" joint1="hip_left" polycoef="1.13446 0 0 0 0" solref="0.002 1"/>
    <joint name="latch_right" joint1="hip_right" polycoef="1.13446 0 0 0 0" solref="0.002 1"/>
    <!-- Front-leg linkages, like the rear: knee angle = -2 x hip angle. -->
    <joint joint1="front_knee_left" joint2="front_hip_left" polycoef="0 -2 0 0 0" solref="0.002 1"/>
    <joint joint1="front_knee_right" joint2="front_hip_right" polycoef="0 -2 0 0 0" solref="0.002 1"/>
  </equality>

  <actuator>
    <!-- Hip torque from each ST3025, through the winder gears.
         The torque-speed limits are applied in servo.py. -->
    <motor name="servo_left" joint="hip_left" ctrlrange="-15.4171 15.4171"/>
    <motor name="servo_right" joint="hip_right" ctrlrange="-15.4171 15.4171"/>
    <!-- Latch-drive springs. legs.py computes the torque from the spring stretch. -->
    <motor name="spring_left" joint="hip_left" ctrlrange="-13.8754 13.8754"/>
    <motor name="spring_right" joint="hip_right" ctrlrange="-13.8754 13.8754"/>
    <!-- Front-leg ST3025s, direct drive. The torque-speed limits are applied in servo.py. -->
    <motor name="front_servo_left" joint="front_hip_left" ctrlrange="-3.92 3.92"/>
    <motor name="front_servo_right" joint="front_hip_right" ctrlrange="-3.92 3.92"/>
  </actuator>
  <!-- MPU-6050 (HAL2-008). hardware.py adds its noise, bias and range limits. -->
  <sensor>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_accel" site="imu"/>
  </sensor>

  <keyframe>
    <key name="crouch" qpos="0 0 0.0995984 1 0 0 0 1.13446 -2.26893 1.13446 -2.26893 0 0.904906 -1.80981 0 0.904906 -1.80981"/>
  </keyframe>
</mujoco>
